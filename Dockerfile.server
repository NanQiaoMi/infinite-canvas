# 构建 Vite 前端产物（同上游静态镜像）。
FROM oven/bun:1.3.13 AS web-build

WORKDIR /app/web
COPY web/package.json web/bun.lock ./
# 上游 bun.lock 使用 npmmirror 解析地址；构建时临时切回官方 registry，避免私有网络下镜像源不可达。
RUN --mount=type=cache,target=/root/.bun/install/cache \
    sed -i 's|registry.npmmirror.com|registry.npmjs.org|g' bun.lock \
    && bun install --frozen-lockfile --cache-dir=/root/.bun/install/cache
COPY VERSION /app/VERSION
COPY CHANGELOG.md /app/CHANGELOG.md
COPY web ./
RUN bun run build

# 服务端模式运行镜像：Bun 同时托管前端静态产物与 /api（额度、管理员、中转）。
FROM oven/bun:1.3.13

WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    DATA_DIR=/app/data \
    TZ=Asia/Shanghai

COPY --from=web-build /app/web/dist ./web/dist
COPY VERSION ./VERSION
COPY CHANGELOG.md ./CHANGELOG.md
COPY server ./server
RUN mkdir -p /app/data

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD ["bun", "-e", "fetch('http://127.0.0.1:3000/api/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["bun", "run", "server/src/index.ts"]
