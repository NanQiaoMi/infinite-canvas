# 服务端模式环境变量示例：复制为 .env 后填写（.env 不会入库）。

# 管理员账号（仅首次启动时用于初始化；之后以数据库为准，可在 /admin 修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# 可选：Cookie 签名 / API Key 加密主密钥；不设置时自动生成并保存到 data/secret.key
# SESSION_SECRET=

# 可选：额度默认值（仅首次初始化写入数据库，之后请在管理后台「额度策略」修改）
QUOTA_IMAGE_DAILY_LIMIT=100
QUOTA_IMAGE_WEEKLY_LIMIT=700
QUOTA_TIMEZONE=Asia/Shanghai

# 前置反向代理时设为 1，从 X-Forwarded-For 取真实客户端 IP
TRUST_PROXY=0

# 可选：统计配置（保持与原静态部署一致）
# ANALYTICS_GA4_ID=
# ANALYTICS_BAIDU_ID=
